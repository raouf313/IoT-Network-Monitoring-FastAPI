@startuml
actor Utilisateur

boundary "Login.js\nReact Login Page" as LoginPage

control "FastAPI\n/api/login" as API

database "Table utilisateurs" as DB

boundary "AdminDashboard.js" as AdminDash
boundary "TechnicienPage.js" as TechDash

Utilisateur -> LoginPage : saisir email + mot de passe

LoginPage -> API : POST /api/login

API -> DB : SELECT * FROM utilisateurs\nWHERE email=? AND mot_de_passe=?

DB --> API : données utilisateur + rôle

alt role = admin
API --> LoginPage : succès login
LoginPage -> AdminDash : redirection dashboard admin

else role = technicien
API --> LoginPage : succès login
LoginPage -> TechDash : redirection espace technicien

else erreur
API --> LoginPage : email ou mot de passe incorrect
end

@enduml

@startuml
!theme toy
skinparam componentStyle rectangle

package "Poste Administrateur" {
    [Navigateur Web Admin] as NavAdmin
}

package "Poste Technicien" {
    [Navigateur Web Tech] as NavTech
}

package "Simulateur Wokwi" {
    [Simulateur ESP32] as ESP32
}

node "Serveur Principal" {
    [Frontend React\n(Port :3000)] as React
    [Backend FastAPI\n(Port :8000)] as FastAPI
    [LM Studio (IA)\n(Port :1234)] as LMStudio
}

database "Serveur BD" {
    [MySQL\n(Port :3306)] as MySQL
}

' Relations
NavAdmin --> React : HTTP
NavTech --> React : HTTP

React --> FastAPI : REST API
FastAPI --> MySQL : SQL Queries
FastAPI <-> LMStudio : OpenAI API Protocol

ESP32 ..> FastAPI : HTTP/WebSocket
NavAdmin <..> FastAPI : WebSockets (Real-time)
NavTech <..> FastAPI : WebSockets (Real-time)

@enduml